# Velan runs without any of these. Copy to .env and fill in only what you have.
# Placeholder values (starting with "your-") are treated as "not set".

# Claude API key: turns on the AI agent that understands free, mixed-language speech.
# Not set -> offline rule-based mode.
ANTHROPIC_API_KEY=your-anthropic-api-key
VELAN_MODEL=claude-opus-5-5

# Sarvam AI key: server-side Indian-language speech-to-text and natural voices.
# Not set -> the browser's own speech recognition and voices are used.
SARVAM_API_KEY=your-sarvam-api-key

# Comma-separated domain packs to load (folders under domains/)
VELAN_DOMAINS=farmer,citizen
