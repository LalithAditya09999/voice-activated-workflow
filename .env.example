# Leave ANTHROPIC_API_KEY empty to run in offline (rule-based) mode.
ANTHROPIC_API_KEY=
VELAN_MODEL=claude-opus-5-5
# Optional: Sarvam AI for server-side Indic speech-to-text / text-to-speech.
# Without it, the browser's built-in speech recognition and voices are used.
SARVAM_API_KEY=
# Comma-separated domain packs to load (folders under domains/)
VELAN_DOMAINS=farmer,citizen
