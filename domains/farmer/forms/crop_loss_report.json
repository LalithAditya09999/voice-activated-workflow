{
  "id": "crop_loss_report",
  "title": {"en": "Crop loss intimation (PMFBY insurance claim)", "ta": "பயிர் இழப்பு தகவல் (பயிர் காப்பீட்டுக் கோரிக்கை)", "hi": "फसल नुकसान सूचना (फसल बीमा दावा)"},
  "submit_to": {"en": "the insurance company toll-free number / Crop Insurance app, your bank branch or the agriculture office — within 72 hours of the loss", "ta": "காப்பீட்டு நிறுவன இலவச எண் / Crop Insurance செயலி, உங்கள் வங்கி அல்லது வேளாண் அலுவலகம் — இழப்பு நடந்த 72 மணி நேரத்துக்குள்", "hi": "बीमा कंपनी का टोल-फ़्री नंबर / Crop Insurance ऐप, आपका बैंक या कृषि कार्यालय — नुकसान के 72 घंटे के भीतर"},
  "deadline_note": {"en": "Report within 72 hours of the damage, or the claim can be rejected.", "ta": "சேதம் நடந்த 72 மணி நேரத்துக்குள் தெரிவிக்கவும், இல்லையெனில் கோரிக்கை நிராகரிக்கப்படலாம்.", "hi": "नुकसान के 72 घंटे के भीतर सूचना दें, वरना दावा खारिज हो सकता है।"},
  "next_step": {"en": "A surveyor visits within a few days. Keep photos of the damaged field with date.", "ta": "சில நாட்களில் ஆய்வாளர் வருவார். சேதமடைந்த வயலின் தேதியுடன் கூடிய புகைப்படங்களை வைத்திருங்கள்.", "hi": "कुछ दिनों में सर्वेयर आएगा। खराब फसल की तारीख वाली फ़ोटो रखें।"},
  "follow_up_days": 10,
  "documents": [
    {"en": "Insurance enrolment receipt / policy number (or crop loan account)", "ta": "காப்பீட்டு பதிவு ரசீது / பாலிசி எண் (அல்லது பயிர்க் கடன் கணக்கு)", "hi": "बीमा रसीद / पॉलिसी नंबर (या फसल ऋण खाता)"},
    {"en": "Dated photos of the damaged crop", "ta": "சேதமடைந்த பயிரின் தேதியுடன் புகைப்படங்கள்", "hi": "खराब फसल की तारीख वाली फ़ोटो"},
    {"en": "Adangal showing the sown crop", "ta": "விதைத்த பயிரைக் காட்டும் அடங்கல்", "hi": "बोई गई फसल का रिकॉर्ड"},
    {"en": "Aadhaar and bank passbook", "ta": "ஆதார் மற்றும் வங்கிப் புத்தகம்", "hi": "आधार और बैंक पासबुक"}
  ],
